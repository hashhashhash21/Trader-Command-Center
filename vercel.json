{
  "version": 2,
  "functions": {
    "api/market.js": {
      "maxDuration": 10
    },
    "api/page.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page"
    }
  ],
  "headers": [
    {
      "source": "/api/market",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
